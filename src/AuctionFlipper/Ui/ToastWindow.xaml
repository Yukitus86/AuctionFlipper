<Window x:Class="AuctionFlipper.Ui.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:AuctionFlipper.Ui.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="368" Focusable="False" ShowActivated="False">

    <Border Background="#F2131A24" BorderBrush="{StaticResource B.Accent}" BorderThickness="1"
            CornerRadius="8" Padding="14,12" Margin="10" Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ctl:ItemChip x:Name="Chip" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13.5"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" Style="{StaticResource T.MonoMuted}" FontSize="11"
                           Margin="0,3,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="HintText" Foreground="{StaticResource B.TextDim}" FontSize="10"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock x:Name="GradeText" FontFamily="{StaticResource F.Mono}" FontSize="19"
                           FontWeight="Bold" HorizontalAlignment="Right" />
                <TextBlock x:Name="NetText" FontFamily="{StaticResource F.Mono}" FontSize="14"
                           FontWeight="SemiBold" Foreground="{StaticResource B.Profit}"
                           HorizontalAlignment="Right" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
