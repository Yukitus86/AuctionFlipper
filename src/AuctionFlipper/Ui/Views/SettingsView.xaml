<UserControl x:Class="AuctionFlipper.Ui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AuctionFlipper.Ui"
             Background="{StaticResource B.Bg}">

    <UserControl.Resources>
        <ui:DoubleTextConverter x:Key="Dbl" />
        <ui:PercentTextConverter x:Key="Pct" />
        <ui:IntTextConverter x:Key="Int" />
        <ui:IntMatchConverter x:Key="IntMatch" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource R.Large}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14,18,24" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="{ui:Tr SettingsTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />

            <!-- ============ connection ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr SecConnection}" Style="{StaticResource T.Label}" Margin="0,0,0,8" />
                    <TextBlock Text="{ui:Tr ConnectionHint}" Style="{StaticResource Hint}" />
                    <!--
                        The key is masked by default, because this screen gets opened while someone
                        is streaming or looking over a shoulder, and the key is the whole account.

                        Two controls rather than one: a PasswordBox cannot be bound - its Password
                        property is deliberately not a dependency property - so the bound TextBox
                        stays the source of truth and the code-behind mirrors the two.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ui:Tr ApiKey}" Style="{StaticResource FieldLabel}" />
                        <Grid Grid.Column="1">
                            <PasswordBox x:Name="ApiKeyMasked" PasswordChanged="OnApiKeyMaskedChanged" />
                            <TextBox x:Name="ApiKeyPlain" Visibility="Collapsed"
                                     TextChanged="OnApiKeyPlainChanged"
                                     Text="{Binding Config.ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <ToggleButton x:Name="ApiKeyReveal" Grid.Column="2" Margin="8,0,0,0"
                                      Style="{StaticResource Btn.Eye}"
                                      Checked="OnApiKeyRevealToggled" Unchecked="OnApiKeyRevealToggled"
                                      ToolTip="{ui:Tr ShowApiKey}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="{Binding ConfigPathText}" />
                </StackPanel>
            </Border>

            <!-- ============ language ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr SecLanguage}" Style="{StaticResource T.Label}" Margin="0,0,0,8" />
                    <TextBlock Text="{ui:Tr LanguageHint}" Style="{StaticResource Hint}" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource Chip.Toggle}" Content="{ui:Tr LangEnglish}"
                                      IsChecked="{Binding LanguageIsEnglish, Mode=OneWay}"
                                      Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                        <ToggleButton Style="{StaticResource Chip.Toggle}" Content="{ui:Tr LangGerman}"
                                      IsChecked="{Binding LanguageIsGerman, Mode=OneWay}"
                                      Command="{Binding SetLanguageCommand}" CommandParameter="de" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ economics ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr SecMarket}" Style="{StaticResource T.Label}" Margin="0,0,0,8" />
                    <TextBlock Text="{ui:Tr MarketHint}" Style="{StaticResource Hint}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{ui:Tr SaleTax}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding Config.TaxRate, Converter={StaticResource Pct}}" />
                        <TextBlock Grid.Column="2" Text="{ui:Tr SaleTaxHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="1" Text="{ui:Tr Capital}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Config.Capital, Converter={StaticResource Dbl}}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{ui:Tr CapitalHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="2" Text="{ui:Tr ListingSlots}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Config.ListingSlots, Converter={StaticResource Int}}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{ui:Tr ListingSlotsHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="3" Text="{ui:Tr ContainerRecovery}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding Config.ContainerHaircut, Converter={StaticResource Pct}}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{ui:Tr ContainerRecoveryHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ filters ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr SecFilters}" Style="{StaticResource T.Label}" Margin="0,0,0,8" />
                    <TextBlock Text="{ui:Tr FiltersHint}" Style="{StaticResource Hint}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{ui:Tr MinProfit}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding Config.MinNetProfit, Converter={StaticResource Dbl}}" />
                        <TextBlock Grid.Column="2" Text="{ui:Tr Coins}" Style="{StaticResource FieldLabel}"
                                   Margin="10,0,0,0" />

                        <TextBlock Grid.Row="1" Text="{ui:Tr MinRoi}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Config.MinRoi, Converter={StaticResource Pct}}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{ui:Tr MinRoiHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="2" Text="{ui:Tr MinConfidence}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Config.MinConfidence, Converter={StaticResource Dbl}}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{ui:Tr ZeroToHundred}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="3" Text="{ui:Tr MinDemand}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding Config.MinSalesPerHour, Converter={StaticResource Dbl}}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{ui:Tr MinDemandHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="4" Text="{ui:Tr MaxBuy}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding Config.MaxBuyPrice, Converter={StaticResource Dbl}}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{ui:Tr NoLimit}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />
                    </Grid>

                    <CheckBox Content="{ui:Tr IncludeContainers}"
                              IsChecked="{Binding Config.IncludeContainers}" Margin="0,12,0,0" />
                    <TextBlock Text="{ui:Tr NbtHint}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ alerts ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr SecAlerts}" Style="{StaticResource T.Label}" Margin="0,0,0,8" />

                    <CheckBox Content="{ui:Tr AlertSound}" IsChecked="{Binding Config.AlertSoundEnabled}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="{ui:Tr AlertToast}" IsChecked="{Binding Config.AlertToastEnabled}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="{ui:Tr AlertCopy}" IsChecked="{Binding Config.AlertAutoCopyEnabled}" />
                    <TextBlock Text="{ui:Tr AlertCopyHint}" Style="{StaticResource Hint}" />

                    <CheckBox Content="{ui:Tr AlertPinned}" IsChecked="{Binding Config.AlertPinnedAlways}" />
                    <TextBlock Text="{ui:Tr AlertPinnedHint}" Style="{StaticResource Hint}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                        <TextBlock Text="{ui:Tr AlertFromGrade}" Style="{StaticResource FieldLabel}" Width="150" />
                        <RadioButton Style="{StaticResource Chip.Radio}" GroupName="grade" Content="{ui:Tr GradeSOnly}"
                                     IsChecked="{Binding Config.AlertMinGrade, Converter={StaticResource IntMatch},
                                                 ConverterParameter=0, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip.Radio}" GroupName="grade" Content="{ui:Tr GradeAUp}"
                                     IsChecked="{Binding Config.AlertMinGrade, Converter={StaticResource IntMatch},
                                                 ConverterParameter=1, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip.Radio}" GroupName="grade" Content="{ui:Tr GradeBUp}"
                                     IsChecked="{Binding Config.AlertMinGrade, Converter={StaticResource IntMatch},
                                                 ConverterParameter=2, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip.Radio}" GroupName="grade" Content="{ui:Tr GradeEverything}"
                                     IsChecked="{Binding Config.AlertMinGrade, Converter={StaticResource IntMatch},
                                                 ConverterParameter=3, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{ui:Tr AlertAbove}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Config.AlertMinNetProfit, Converter={StaticResource Dbl}}" />
                        <TextBlock Grid.Column="2" Text="{ui:Tr AlertAboveHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="1" Text="{ui:Tr Cooldown}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Config.AlertCooldownSeconds, Converter={StaticResource Int}}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{ui:Tr CooldownHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />
                    </Grid>

                    <Button Content="{ui:Tr TestSound}" Command="{Binding TestAlertCommand}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ collectors ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr SecBudget}" Style="{StaticResource T.Label}" Margin="0,0,0,8" />
                    <TextBlock Text="{ui:Tr BudgetHint}" Style="{StaticResource Hint}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{ui:Tr Ceiling}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Config.RequestsPerMinute, Converter={StaticResource Int}}" />
                        <TextBlock Grid.Column="2" Text="{ui:Tr CeilingHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="1" Text="{ui:Tr NewListings}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Config.SniperGuarantee, Converter={StaticResource Int}}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{ui:Tr NewListingsHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="2" Text="{ui:Tr TapeShare}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Config.TapeGuarantee, Converter={StaticResource Int}}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{ui:Tr TapeShareHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="3" Text="{ui:Tr YourClicks}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding Config.InteractiveGuarantee, Converter={StaticResource Int}}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{ui:Tr YourClicksHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />
                    </Grid>

                    <CheckBox Content="{ui:Tr SweeperEnabled}"
                              IsChecked="{Binding Config.SweeperEnabled}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ storage ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{ui:Tr SecStorage}" Style="{StaticResource T.Label}" Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{ui:Tr KeepHistory}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Config.SaleRetentionDays, Converter={StaticResource Int}}" />
                        <TextBlock Grid.Column="2" Text="{ui:Tr KeepHistoryHint}"
                                   Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />
                    </Grid>

                    <CheckBox Content="{ui:Tr WarmStart}" IsChecked="{Binding Config.WarmStart}"
                              Margin="0,12,0,0" />
                    <TextBlock Text="{ui:Tr WarmStartHint}" Style="{StaticResource Hint}" />

                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="{Binding StorageText}" />
                </StackPanel>
            </Border>

            <Button Content="{ui:Tr SaveSettings}" Style="{StaticResource Btn.Accent}" Padding="18,7"
                    Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
