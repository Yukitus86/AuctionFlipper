<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base text -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontBase}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontTiny}" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <!-- Tracked-out small caps read as column headers without needing rules or boxes. -->
        <Setter Property="TextBlock.LineHeight" Value="12" />
    </Style>

    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontBase}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

    <Style x:Key="T.MonoMuted" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontSmall}" />
    </Style>

    <Style x:Key="T.Money" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
        <Setter Property="FontSize" Value="{StaticResource S.FontLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Small}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF262F3D" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF303B4C" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource B.AccentDim}" />
        <Setter Property="Foreground" Value="#FF1A1205" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Nav tabs down the left rail -->
    <Style x:Key="Nav.Item" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource R.Small}"
                                Padding="14,9" Margin="6,1" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <!-- Active marker: a short accent bar, cheaper on the eye than a filled tab. -->
                        <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,7"
                                CornerRadius="0,2,2,0" Background="{StaticResource B.Accent}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF161D28" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF1A2230" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sort / filter chips -->
    <Style x:Key="Chip.Toggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource B.SurfaceAlt}"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                            CornerRadius="10" Padding="11,4" Margin="0,0,6,0" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF2A2110" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same chip, as a radio button, for picking one value out of a small set -->
    <Style x:Key="Chip.Radio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource B.SurfaceAlt}"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                            CornerRadius="10" Padding="13,4" Margin="0,0,6,0" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF2A2110" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Switch-style checkbox for the settings page -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Track" Width="34" Height="18" CornerRadius="9"
                                Background="{StaticResource B.SurfaceRaised}"
                                BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{StaticResource B.TextDim}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#FF2A2110" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.AccentDim}" />
        <Setter Property="Background" Value="{StaticResource B.Bg}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontSmall}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Small}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Matches the TextBox above, so the API key field looks the same masked as revealed. -->
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.AccentDim}" />
        <Setter Property="Background" Value="{StaticResource B.Bg}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontSmall}" />
        <Setter Property="PasswordChar" Value="&#x2022;" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Small}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The reveal toggle beside the API key. Two hand-drawn eyes rather than a glyph font, so the
         icon looks the same on a machine with a different set of fonts installed. -->
    <Style x:Key="Btn.Eye" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource B.Bg}"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource R.Small}" Width="32" Height="30">
                        <Grid>
                            <Path x:Name="Open" Stroke="{StaticResource B.TextMuted}" StrokeThickness="1.3"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 1,7 C 4,2.2 12,2.2 15,7 C 12,11.8 4,11.8 1,7 Z
                                        M 8,4.9 A 2.1,2.1 0 1 1 7.98,4.9 Z" />
                            <Path x:Name="Closed" Stroke="{StaticResource B.TextMuted}" StrokeThickness="1.3"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 1,7 C 4,2.2 12,2.2 15,7 C 12,11.8 4,11.8 1,7 Z
                                        M 8,4.9 A 2.1,2.1 0 1 1 7.98,4.9 Z
                                        M 1.5,12.5 L 14.5,1.5" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Open" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Closed" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Open" Property="Stroke" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Closed" Property="Stroke" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scrollbar so dense tables keep their width -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#FF2C3644" CornerRadius="4" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="9" />
                            <Setter Property="Width" Value="Auto" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

    <!-- Tooltips ship with the Windows light theme, which on this palette means a white card with
         black text appearing over a near-black board. Restyled to match everything else. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource S.FontSmall}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MaxWidth" Value="300" />
        <!-- TextWrapping is not an inherited property, so a tooltip longer than MaxWidth would be
             cut off rather than wrapped unless the text block is supplied here. Every tooltip in
             the app is a plain string. -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource B.SurfaceAlt}"
                            BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1"
                            CornerRadius="{StaticResource R.Small}" Padding="9,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The hover card on a board row.

        It clears the plain tooltip's ContentTemplate: that template exists to wrap a string, and
        this tooltip's content is a laid-out panel, which the string template would try to render
        through a TextBlock and destroy. The padding goes to zero for the same reason - the card
        draws its own sections and rules.
    -->
    <Style x:Key="Tip.Card" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="MaxWidth" Value="460" />
        <Setter Property="ContentTemplate" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource B.Surface}"
                            BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1"
                            CornerRadius="{StaticResource R.Large}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A whole table row turned into a button. Chromeless until hovered, because a tape printing
         several sales a second must not look like a wall of buttons - the hover is the only thing
         that says the row can be clicked at all. -->
    <Style x:Key="Row.Click" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="{StaticResource R.Medium}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource B.SurfaceAlt}" />
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource B.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A star the row can be pinned with. Chromeless until hovered, so 250 of them down a list
         read as one faint column rather than 250 buttons. -->
    <Style x:Key="Btn.Pin" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource R.Small}"
                            Width="24" Height="24">
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SurfaceRaised}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
