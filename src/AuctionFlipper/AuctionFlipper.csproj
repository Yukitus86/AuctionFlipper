<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AuctionFlipper</AssemblyName>
    <RootNamespace>AuctionFlipper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <Product>Auction Flipper</Product>
    <AssemblyTitle>Auction Flipper</AssemblyTitle>
    <Description>Tracks the DonutSMP auction house and ranks profitable flips.</Description>

    <!-- The app's own strings are a hand-rolled table in Localization.cs, not satellite assemblies.
         This keeps the framework's own satellites out of the single file. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- App.xaml is compiled as a Page so Program.cs can own Main and offer a console self-test. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>AuctionFlipper.Program</StartupObject>

    <!-- One file, and nothing beside it.

         A single-file publish leaves WPF's five native libraries (wpfgfx, PresentationNative,
         D3DCompiler, PenImc, vcruntime) loose in the output folder unless they are told to come
         along, and ships a .pdb next to the executable. Neither belongs in something that gets
         copied to a desktop and double-clicked: the loose DLLs look like the app is broken if one
         is missing, and a folder of six files invites moving the exe on its own, which breaks it.
         Symbols are embedded in the binary instead, so a stack trace still names lines. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- The item icon sheet and its index. Embedding keeps the single-file build self-contained:
         the icons must be there on a machine with no internet connection at all. -->
    <EmbeddedResource Include="Assets\icons.png" />
    <EmbeddedResource Include="Assets\icons.idx" />
  </ItemGroup>

</Project>
